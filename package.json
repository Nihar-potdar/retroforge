{
  "name": "3d-pcpartpicker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/dev.ts",
